{
  "name": "duwa-lang",
  "displayName": "Duwa Language",
  "description": "Syntax highlighting for Duwa language",
  "publisher": "sevenreup",
  "version": "0.0.1",
  "icon": "assets/images/duwa.png",
  "repository": "https://github.com/sevenreup/duwa-extensions",
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "lint": "eslint",
    "postinstall": "cd client && pnpm install && cd ..",
    "test": "sh ./scripts/e2e.sh"
  },
  "main": "./client/out/extension",
  "contributes": {
    "languages": [
      {
        "id": "duwa",
        "aliases": [
          "Duwa",
          "duwa"
        ],
        "extensions": [
          ".duwa"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "duwa",
        "scopeName": "source.duwa",
        "path": "./syntaxes/duwa.tmLanguage.json"
      }
    ],
    "configuration": {}
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vsce": "^2.15.0"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.18.1"
  }
}